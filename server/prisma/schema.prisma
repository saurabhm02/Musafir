generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// PostGIS geography columns show up as Unsupported() below -- Prisma can't
// type them, so queries touching `location`/`polyline` use $queryRaw.
// auth.users (Supabase Auth's own table) is intentionally not modeled here
// -- the DB-level foreign key still enforces it, Prisma just doesn't need
// to query it.

model users {
  id                String     @id @db.Uuid
  email             String?
  username          String?    @unique
  full_name         String?
  avatar_url        String?
  bio               String?
  location          Unsupported("geography")?
  home_city         String?
  preferences       Json?      @default("{}")
  subscription_tier String?    @default("free")
  total_distance_km Decimal?   @default(0) @db.Decimal
  total_trips       Int?       @default(0)
  created_at        DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?  @default(now()) @db.Timestamptz(6)
  memories          memories[]
  pois              pois[]
  routes            routes[]
  trips             trips[]
  poi_status        poi_status[]
}

model routes {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  origin            String
  destination       String
  origin_coord      Unsupported("geography")?
  destination_coord Unsupported("geography")?
  polyline          Unsupported("geography")?
  distance_km       Decimal?          @db.Decimal
  duration_minutes  Decimal?          @db.Decimal
  elevation_gain_m  Decimal?          @db.Decimal
  created_by        String?           @db.Uuid
  is_public         Boolean?          @default(true)
  search_count      Int?              @default(0)
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  poi_route         poi_route[]
  route_segments    route_segments[]
  users             users?            @relation(fields: [created_by], references: [id])

  @@index([polyline], map: "routes_polyline_gix", type: Gist)
}

model route_segments {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  route_id         String?                    @db.Uuid
  segment_index    Int
  polyline         Unsupported("geography")
  start_coord      Unsupported("geography")?
  end_coord        Unsupported("geography")?
  distance_km      Decimal?                   @db.Decimal
  elevation_gain_m Decimal?                   @db.Decimal
  bearing_deg      Int?
  created_at       DateTime?                  @default(now()) @db.Timestamptz(6)
  poi_route        poi_route[]
  routes           routes?                    @relation(fields: [route_id], references: [id], onDelete: Cascade)

  @@index([polyline], map: "route_segments_polyline_gix", type: Gist)
  @@index([start_coord], map: "route_segments_start_gix", type: Gist)
}

model pois {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  description   String?
  category      String
  subcategory   String?
  location      Unsupported("geography")
  address       String?
  tags          String[]      @default([])
  price_range   String?
  best_time     String?
  avg_rating    Decimal?      @default(0) @db.Decimal
  total_ratings Int?          @default(0)
  total_photos  Int?          @default(0)
  created_by    String?       @db.Uuid
  is_verified   Boolean?      @default(false)
  created_at    DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?     @default(now()) @db.Timestamptz(6)
  memories      memories[]
  poi_route     poi_route[]
  trip_stops    trip_stops[]
  poi_status    poi_status[]
  poi_metadata  poi_metadata?
  poi_photos    poi_photos[]
  poi_routes    poi_routes[]
  users         users?        @relation(fields: [created_by], references: [id])

  @@index([location], map: "pois_location_gix", type: Gist)
}

// One row per POI -- every enrichment fact that isn't in `pois` itself:
// trek/trail facts (difficulty, distance, elevation, etc, nullable for
// non-trek categories) plus general facts (state/district/city/country,
// website, opening_hours, entry_fee, estimated visit duration). Merged from
// the former separate poi_details table (docs/poi-architecture-audit.md) --
// there was no real reason to split "general" from "trek" enrichment facts
// across two tables when both are 1:1 with poi_id. Row-level source/
// confidence tracks where this bundle of fields came from; NULL means "not
// verified from any source yet," never a guess (see enrich-pois.ts).
model poi_metadata {
  id                                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poi_id                            String    @unique @db.Uuid
  difficulty                        String?
  distance_km                       Decimal?  @db.Decimal
  duration_hours                    Decimal?  @db.Decimal
  elevation_gain_m                  Decimal?  @db.Decimal
  max_elevation_m                   Decimal?  @db.Decimal
  best_time                         String?
  starting_point                    String?
  ending_point                      String?
  state                             String?
  district                          String?
  city                              String?
  country                           String?
  website                           String?
  opening_hours                     String?
  entry_fee                         String?
  estimated_visit_duration_minutes Int?
  source                            String
  confidence                        String    @default("unverified")
  updated_at                        DateTime  @default(now()) @db.Timestamptz(6)
  pois                              pois      @relation(fields: [poi_id], references: [id], onDelete: Cascade)
}

// Zero or more real photos per POI, each traceable to where it came from.
// Distinct from `memories`, which is user-uploaded content.
// `url` is the app-facing image (our S3/CDN copy once verified+downloaded);
// `original_url`/`source_page`/`author`/`license` preserve full provenance
// back to the real source so attribution is always reconstructable.
model poi_photos {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poi_id        String   @db.Uuid
  source        String
  source_id     String?
  url           String
  original_url  String?
  source_page   String?
  author        String?
  license       String?
  width         Int?
  height        Int?
  attribution   String?
  confidence    String   @default("unverified")
  metadata      Json     @default("{}")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  pois          pois     @relation(fields: [poi_id], references: [id], onDelete: Cascade)

  @@unique([poi_id, source, source_id])
}

// Real trail/trek geometry (LineString), separate from the POI's own POINT
// location. A POI can have more than one candidate route (e.g. different
// sources or route variants); each is independently source-tracked.
model poi_routes {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poi_id           String                     @db.Uuid
  route_type       String                     @default("hiking")
  geometry         Unsupported("geography(linestring, 4326)")
  distance_km      Decimal?                   @db.Decimal
  elevation_gain_m Decimal?                   @db.Decimal
  source           String
  source_id        String?
  confidence       String                     @default("unverified")
  created_at       DateTime                   @default(now()) @db.Timestamptz(6)
  pois             pois                       @relation(fields: [poi_id], references: [id], onDelete: Cascade)

  @@unique([poi_id, source, source_id])
  @@index([geometry], map: "poi_routes_geometry_gix", type: Gist)
}

model trips {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String       @db.Uuid
  title                String
  destination          String?
  day_count            Int          @default(1)
  status               String       @default("planned")
  started_at           DateTime?    @db.Timestamptz(6)
  completed_at         DateTime?    @db.Timestamptz(6)
  actual_distance_km   Decimal?     @db.Decimal
  actual_duration_min  Decimal?     @db.Decimal
  moving_duration_min  Decimal?     @db.Decimal
  elevation_gain_m     Decimal?     @db.Decimal
  max_speed_kmh        Decimal?     @db.Decimal
  avg_speed_kmh        Decimal?     @db.Decimal
  recorded_route       Unsupported("geography(linestring, 4326)")?
  start_location       Unsupported("geography(point, 4326)")?
  end_location         Unsupported("geography(point, 4326)")?
  telemetry_s3_key     String?
  is_public            Boolean?     @default(false)
  created_at           DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?    @default(now()) @db.Timestamptz(6)
  users                users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  trip_stops           trip_stops[]

  @@index([user_id, status], map: "trips_user_status_idx")
  @@index([recorded_route], map: "trips_recorded_route_gix", type: Gist)
}

model trip_stops {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id    String    @db.Uuid
  poi_id     String    @db.Uuid
  day_number Int
  time_label String?
  note       String?
  sort_order Int       @default(0)
  status     String?   @default("pending")
  arrived_at DateTime? @db.Timestamptz(6)
  departed_at DateTime? @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  trips      trips     @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  pois       pois      @relation(fields: [poi_id], references: [id], onDelete: Cascade)

  @@index([trip_id, day_number, sort_order], map: "trip_stops_trip_day_idx")
}

model poi_status {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  poi_id     String    @db.Uuid
  status     String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pois       pois      @relation(fields: [poi_id], references: [id], onDelete: Cascade)

  @@unique([user_id, poi_id])
}

model poi_route {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poi_id            String?         @db.Uuid
  route_id          String?         @db.Uuid
  segment_id          String?         @db.Uuid
  detour_distance_m   Decimal?        @db.Decimal
  detour_duration_sec Int?
  is_on_route         Boolean?        @default(true)
  pois                pois?           @relation(fields: [poi_id], references: [id], onDelete: Cascade)
  routes              routes?         @relation(fields: [route_id], references: [id], onDelete: Cascade)
  route_segments      route_segments? @relation(fields: [segment_id], references: [id], onDelete: Cascade)

  @@index([route_id], map: "poi_route_route_idx")
  @@index([segment_id], map: "poi_route_segment_idx")
}

model memories {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String?                    @db.Uuid
  poi_id            String?                    @db.Uuid
  trip_id           String?                    @db.Uuid
  original_key      String?
  thumbnail_key     String?
  photo_url         String
  thumbnail_url     String?
  mime_type         String?
  width             Int?
  height            Int?
  file_size         Int?
  caption           String?
  visibility        String?                    @default("private")
  status            String?                    @default("processing")
  moderation_status String?                    @default("approved")
  ai_tags           String[]
  ai_description    String?
  taken_at          DateTime?                  @db.Timestamptz(6)
  location          Unsupported("geography")?
  created_at        DateTime?                  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?                  @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime?                  @db.Timestamptz(6)
  pois              pois?                      @relation(fields: [poi_id], references: [id], onDelete: Cascade)
  users             users?                     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([location], map: "memories_location_gix", type: Gist)
  @@index([user_id], map: "memories_user_id_idx")
  @@index([poi_id], map: "memories_poi_id_idx")
  @@index([trip_id], map: "memories_trip_id_idx")
  @@index([visibility, status, moderation_status], map: "memories_visibility_status_idx")
}
